# Variables de producción del VPS. `./scripts/deploy.sh init` genera `.env.prod` con valores aleatorios.
# Nunca subas `.env.prod` al repo. Las variables del backend (LLM, admin, JWT...) y de la web (Mapbox)
# siguen en backend/.env y web/.env, igual que en desarrollo.

POSTGRES_PASSWORD=
GARAGE_RPC_SECRET=
GARAGE_ADMIN_TOKEN=

# Llave de la app en Garage (la importa scripts/place-images.sh): "GK" + 24 hex, y 64 hex.
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=lugares
S3_REGION=garage
PLACE_IMAGES_PUBLIC_URL=https://img.ondesanmarcos.site
