# Copia este archivo a `.env` y ajusta los valores. Nunca subas `.env` al repo.

# Backend FastAPI (local por defecto)
VITE_API_URL=http://localhost:8000

# Token PÚBLICO de Mapbox (empieza con pk.). Créalo en https://account.mapbox.com
VITE_MAPBOX_TOKEN=pk.REEMPLAZAR_CON_TU_TOKEN_PUBLICO

# Chat: pon 'true' para usar respuestas simuladas sin backend
VITE_USE_MOCK_CHAT=false

# Logs de red en consola (solo desarrollo)
VITE_ENABLE_DEV_LOGS=true
