# Configuración del backend OndeSanMarcos (asistente RAG)
# Copia este archivo a `.env` y ajusta los valores.

# --- Aplicación ---
APP_ENV=development
# Orígenes permitidos por CORS (separados por coma). * = todos (solo en dev).
CORS_ORIGINS=*

# --- Motor RAG ---
# Si es true, usa proveedores mock (embeddings + LLM) y NO requiere llaves.
# Permite probar el sistema de forma aislada, sin base vectorial ni un LLM real.
RAG_USE_MOCK=true
# Cuántos fragmentos recuperar por consulta.
RAG_TOP_K=4
# Umbral mínimo de similitud (0..1) para considerar que hay contexto relevante.
# 0.55 está calibrado para los embeddings densos de Gemini (producción);
# el mock (bag-of-words) usa scores más bajos, pero los tests fuerzan mock aparte.
RAG_SCORE_THRESHOLD=0.55

# --- Proveedores reales (solo cuando RAG_USE_MOCK=false) ---
# LLM (gemini | openai | anthropic).
#   gemini    -> instala requirements-llm.txt; LLM_MODEL ej. gemini-2.5-flash
#   openai    -> requirements-rag.txt; LLM_MODEL ej. gpt-4o-mini
#   anthropic -> requirements-rag.txt; LLM_MODEL ej. claude-haiku-4-5-20251001
# NUNCA subas la LLM_API_KEY al repo; este archivo es solo un ejemplo.
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=

# Supabase (Postgres + pgvector) para la base de conocimiento.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# --- Herramientas offline (opcional; NO las usa el servidor en runtime) ---
# Solo para el generador de lugares desde Google Places (app/tools/maps).
# Requiere una clave de Google Cloud con "Places API (New)" habilitada + billing.
# No hace falta en Render; solo si vas a correr fetch_places/build_unmsm_ts.
GOOGLE_MAPS_API_KEY=
