# Variables de producción del VPS. Copia a `deploy/.env` (NO se versiona):
#   cp .env.example .env && chmod 600 .env
# Las marcadas con [SECRETO] nunca van al repo ni al chat.
# No pongas comentarios al final de una línea con valor.

# --- Proxy / HTTPS ---
# caddy = este compose levanta Caddy en 80/443 (VPS con esos puertos libres).
# Déjalo vacío si el VPS ya tiene nginx/Caddy: entonces apunta ese proxy a
# 127.0.0.1:API_HOST_PORT (ver documents/10-despliegue-vps.md §10.5).
COMPOSE_PROFILES=caddy
API_HOST_PORT=8010
# Dominio que apunta a la IP del VPS (registro A). Ej: ondesanmarcos.duckdns.org
DOMAIN=
# Correo para Let's Encrypt (avisos sobre el certificado).
ACME_EMAIL=ondesanmarcos@gmail.com

# --- Backend ---
APP_ENV=production
# La app móvil nativa no aplica CORS; se limita al propio dominio por si
# algún día hay un front web. Ej: https://ondesanmarcos.duckdns.org
CORS_ORIGINS=
# Consultas por minuto y por IP a /api/chat.
RATE_LIMIT_PER_MINUTE=20

# --- Motor RAG ---
RAG_USE_MOCK=false
RAG_TOP_K=4
RAG_SCORE_THRESHOLD=0.55

# --- LLM (Gemini · Google AI Studio, cuenta del equipo) ---
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash
# [SECRETO] API key de AI Studio.
LLM_API_KEY=

# --- Supabase (Project Settings → API) ---
# https://<ref>.supabase.co
SUPABASE_URL=
# [SECRETO] service_role (o "secret key"). NUNCA la anon/publishable.
SUPABASE_SERVICE_KEY=
