# Variables del frontend. Copia a `.env` para desarrollo local (NO se versiona).
# Para los builds de EAS, estas mismas variables se cargan en Expo:
#   npx eas-cli env:create   (ver documents/10-despliegue-vps.md §10.8)
#
# Las EXPO_PUBLIC_* quedan embebidas en la app y son públicas por diseño
# (token pk. de Mapbox, anon key de Supabase). NUNCA pongas aquí la
# service_role de Supabase ni la API key de Gemini: esas viven solo en el backend.

# --- Mapbox (cuenta del equipo) ---
# Token público (empieza con pk.)
EXPO_PUBLIC_MAPBOX_TOKEN=
# [SECRETO] Token de descarga del SDK (empieza con sk., scope DOWNLOADS:READ).
# Solo se usa al compilar; en EAS se crea con visibilidad "secret".
RNMAPBOX_MAPS_DOWNLOAD_TOKEN=

# --- Supabase (Project Settings → API) ---
EXPO_PUBLIC_SUPABASE_URL=
# anon / publishable key (pública; protegida por RLS)
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# --- Backend FastAPI ---
# Producción: https://<dominio-del-vps>
# Desarrollo: emulador http://localhost:8000 · dispositivo LAN http://192.168.1.X:8000
EXPO_PUBLIC_API_URL=

# Chat: 'true' usa respuestas mock locales en lugar del backend.
EXPO_PUBLIC_USE_MOCK_CHAT=false

# Logs de red en consola (solo desarrollo).
EXPO_PUBLIC_ENABLE_DEV_LOGS=false
