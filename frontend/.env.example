# Mapbox
EXPO_PUBLIC_MAPBOX_TOKEN=pk.REEMPLAZAR_CON_TU_TOKEN_PUBLICO

# Supabase
EXPO_PUBLIC_SUPABASE_URL=https://TU_PROYECTO.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=REEMPLAZAR_CON_TU_ANON_KEY

# Backend FastAPI
# Por defecto (sin esta variable) la app usa el backend desplegado en Render.
# Para desarrollo local contra el backend en tu máquina, descomenta y ajusta:
#   - Emulador:        http://localhost:8000
#   - Dispositivo LAN: http://192.168.1.X:8000 (IP de tu PC)
# EXPO_PUBLIC_API_URL=http://localhost:8000

# Chat: por defecto consume el backend. Pon 'true' para respuestas mock locales.
EXPO_PUBLIC_USE_MOCK_CHAT=false

# Dev
EXPO_PUBLIC_ENABLE_DEV_LOGS=true

RNMAPBOX_MAPS_DOWNLOAD_TOKEN=sk.REEMPLAZAR_CON_TU_TOKEN_SECRETO

MAPBOX_PUBLIC_TOKEN=pk.REEMPLAZAR_CON_TU_TOKEN_PUBLICO
